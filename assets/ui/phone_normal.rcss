/* Phone theme: near-black ground, grouped cards, one teal accent. All sizes
   are in dp so the layout scales with the display. The renderer has no shader
   or layer support, so stick to flat colours, vertex gradients, radii,
   opacity and transforms (no box-shadow, filter or linear-gradient). */

body {
	font-family: "Liberation Sans";
	font-size: 17dp;
	color: #f2f2f5;
	background-color: #08080b;
	decorator: vertical-gradient(#171a1f #08090b);
	width: 100%;
	height: 100%;
	display: block;
}

/* --- Status bar ------------------------------------------------------- */

.status-bar {
	display: block;
	height: 44dp;
	padding: 14dp 28dp 0 28dp;
	font-size: 15dp;
	font-weight: bold;
	color: #f2f2f5;
}

.status-bar .clock {
	float: left;
}

.status-bar .icons {
	float: right;
	height: 12dp;
	margin-top: 3dp;
}

.signal {
	display: inline-block;
	width: 3dp;
	margin-left: 2dp;
	background-color: #f2f2f5;
	border-radius: 1dp;
	vertical-align: bottom;
}

.signal.s1 { height: 4dp; }
.signal.s2 { height: 6dp; }
.signal.s3 { height: 9dp; }
.signal.s4 { height: 12dp; background-color: #5a5a64; }

.battery {
	display: inline-block;
	width: 22dp;
	height: 10dp;
	margin-left: 8dp;
	padding: 1dp;
	border: 1dp #8c8c96;
	border-radius: 3dp;
	vertical-align: bottom;
}

.battery .charge {
	display: block;
	width: 72%;
	height: 100%;
	background-color: #f2f2f5;
	border-radius: 1dp;
}

/* --- Headers ---------------------------------------------------------- */

.hero {
	display: block;
	padding: 150dp 28dp 40dp 28dp;
}

.wordmark {
	display: block;
	font-size: 56dp;
	font-weight: bold;
	letter-spacing: 6dp;
	color: #f2f2f5;
}

.wordmark .dot {
	color: #36dede;
}

.tagline {
	display: block;
	margin-top: 6dp;
	font-size: 15dp;
	letter-spacing: 1dp;
	color: #8c8c96;
}

.header {
	display: block;
	height: 52dp;
	padding: 4dp 16dp 0 16dp;
}

.header .back {
	display: inline-block;
	height: 40dp;
	padding: 0 12dp 0 8dp;
	font-size: 17dp;
	line-height: 40dp;
	color: #36dede;
	border-radius: 20dp;
	transition: background-color 0.12s;
}

.header .back:hover {
	background-color: #36dede1f;
}

.header .back:active {
	background-color: #36dede40;
}

.page-title {
	display: block;
	padding: 4dp 28dp 20dp 28dp;
	font-size: 34dp;
	font-weight: bold;
	color: #f2f2f5;
}

/* --- Content ---------------------------------------------------------- */

.page {
	display: block;
	padding: 0 16dp;
	animation: 0.22s cubic-out page-in;
}

@keyframes page-in {
	from { opacity: 0; transform: translateY(14dp); }
	to { opacity: 1; transform: translateY(0dp); }
}

/* Sub-page lists scroll under a fixed header and title. Top is the status
   bar + header + title heights; bottom leaves room for the home bar. */
.scroll {
	position: absolute;
	top: 160dp;
	bottom: 24dp;
	left: 0;
	right: 0;
	overflow-y: auto;
	padding-bottom: 16dp;
}

scrollbarvertical {
	width: 4dp;
	margin-right: 4dp;
}

scrollbarvertical sliderbar {
	min-height: 32dp;
	background-color: #ffffff30;
	border-radius: 2dp;
}

.section {
	display: block;
	padding: 18dp 14dp 8dp 14dp;
	font-size: 12dp;
	font-weight: bold;
	letter-spacing: 1.5dp;
	color: #8c8c96;
}

/* Rows sit inset in the card with their own radius, so hover pills look right
   whichever rows data-if / data-for leave visible. */
.group {
	display: block;
	margin-bottom: 12dp;
	padding: 4dp;
	background-color: #17171d;
	border-radius: 18dp;
}

button.row {
	display: block;
	height: 52dp;
	padding: 0 14dp;
	font-size: 17dp;
	line-height: 52dp;
	text-align: left;
	color: #f2f2f5;
	border-radius: 14dp;
	transition: background-color 0.12s;
	position: relative;
}

button.row:hover {
	background-color: #24242c;
}

button.row:active {
	background-color: #30303a;
}

.row .chevron {
	position: absolute;
	top: 0;
	right: 16dp;
	color: #55555f;
	font-size: 17dp;
}

.row .hint {
	position: absolute;
	top: 0;
	right: 36dp;
	font-size: 15dp;
	color: #8c8c96;
}

.row.danger {
	color: #ff5a5f;
}

/* The one filled call to action on a screen. */
button.primary {
	display: block;
	height: 60dp;
	margin-bottom: 12dp;
	font-size: 19dp;
	font-weight: bold;
	line-height: 60dp;
	text-align: center;
	color: #071013;
	background-color: #36dede;
	decorator: vertical-gradient(#65f0f0 #00cacb);
	border-radius: 18dp;
	transition: transform 0.1s cubic-out;
}

button.primary:hover {
	decorator: vertical-gradient(#80f4f4 #36dede);
}

button.primary:active {
	transform: scale(0.97);
}

.empty {
	display: block;
	padding: 18dp;
	font-size: 15dp;
	text-align: center;
	color: #8c8c96;
}

/* --- Home indicator --------------------------------------------------- */

.home-bar {
	position: absolute;
	bottom: 10dp;
	left: 50%;
	width: 134dp;
	height: 5dp;
	margin-left: -67dp;
	background-color: #f2f2f5;
	border-radius: 3dp;
	opacity: 0.85;
}

/* --- Settings ---------------------------------------------------------- */

/* An iOS-style switch at the row's right edge; .on when the setting is. */
.switch {
	position: absolute;
	top: 16dp;
	right: 16dp;
	width: 46dp;
	height: 28dp;
	border-radius: 14dp;
	background-color: #3a3a44;
	transition: background-color 0.18s;
}

.switch.on {
	background-color: #36dede;
}

.switch .knob {
	position: absolute;
	top: 3dp;
	left: 3dp;
	width: 22dp;
	height: 22dp;
	border-radius: 11dp;
	background-color: #f2f2f5;
	transition: left 0.18s cubic-out;
}

.switch.on .knob {
	left: 21dp;
}


/* --- Home screen -------------------------------------------------------- */

/* The Play widget: a glass card holding the wordmark, what Play starts, and
   the one filled button. */
.widget {
	display: block;
	margin: 34dp 8dp 0 8dp;
	padding: 20dp;
	background-color: #1a1d22e6;
	border: 1dp #ffffff1f;
	border-radius: 28dp;
}

.widget-head {
	display: block;
	height: 62dp;
	position: relative;
}

.wordmark.small {
	font-size: 31dp;
	letter-spacing: 3dp;
}

.widget .tag {
	position: absolute;
	top: 4dp;
	right: 0;
	font-size: 11dp;
	font-weight: bold;
	letter-spacing: 1dp;
	color: #8d939c;
}

/* Stands in for a level thumbnail until there is one to draw. */
.thumb {
	display: block;
	position: relative;
	height: 110dp;
	margin-bottom: 16dp;
	background-color: #1c2127;
	decorator: vertical-gradient(#222831 #171b20);
	border-radius: 16dp;
}

.thumb-label {
	position: absolute;
	left: 12dp;
	bottom: 10dp;
	font-size: 13dp;
	color: #a9b0b8;
}

button.play {
	display: block;
	height: 58dp;
	font-size: 22dp;
	font-weight: bold;
	letter-spacing: 3dp;
	line-height: 58dp;
	text-align: center;
	color: #071013;
	background-color: #36dede;
	border-radius: 18dp;
	transition: transform 0.1s cubic-out;
}

button.play:hover {
	background-color: #65f0f0;
}

button.play:active {
	transform: scale(0.98);
}

.play-icon {
	margin-right: 10dp;
	font-size: 16dp;
}

/* App icons: a tinted rounded square with a dark mark, label beneath. */
.apps {
	display: flex;
	flex-wrap: wrap;
	margin: 28dp 15dp 0 15dp;
}

.apps .app {
	width: 33.33%;
}

button.app {
	display: flex;
	flex-direction: column;
	align-items: center;
	transition: transform 0.1s cubic-out;
}

button.app:active {
	transform: scale(0.94);
}

.app-icon {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 72dp;
	height: 72dp;
	border: 1dp #ffffff33;
	border-radius: 20dp;
}

.app-label {
	display: block;
	margin-top: 7dp;
	font-size: 12dp;
	color: #eef0f2;
}

.app-icon.gold { background-color: #f5c761; }
.app-icon.teal { background-color: #36dede; }
.app-icon.purple { background-color: #caacff; }
.app-icon.silver { background-color: #d4d8dc; }
.app-icon.red { background-color: #f97770; }

/* Dark marks on the icons; tri is a font glyph, as radii can't make one. */
.glyph {
	display: block;
	width: 26dp;
	height: 26dp;
	color: #0c0e10;
}

.glyph.circle { background-color: #0c0e10; border-radius: 13dp; }
.glyph.square { background-color: #0c0e10; border-radius: 4dp; }
.glyph.diamond { width: 22dp; height: 22dp; background-color: #0c0e10; border-radius: 3dp; transform: rotate(45deg); }
.glyph.bar { height: 8dp; background-color: #0c0e10; border-radius: 2dp; }
.glyph.tri { font-size: 40dp; line-height: 24dp; text-align: center; }

/* The dock: system apps on a glass shelf above the home bar. */
.dock {
	position: absolute;
	left: 13dp;
	right: 13dp;
	bottom: 30dp;
	display: flex;
	justify-content: space-around;
	padding: 13dp 16dp;
	background-color: #282b30d9;
	border: 1dp #ffffff1f;
	border-radius: 37dp;
}

.dock .app-icon {
	width: 64dp;
	height: 64dp;
	border-radius: 18dp;
}

.dock .glyph {
	width: 22dp;
	height: 22dp;
}

.dock .glyph.circle { border-radius: 11dp; }
.dock .glyph.diamond { width: 18dp; height: 18dp; }
.dock .glyph.bar { height: 7dp; }
.dock .glyph.tri { font-size: 34dp; line-height: 20dp; }

.dock .app-label {
	font-size: 11dp;
}
