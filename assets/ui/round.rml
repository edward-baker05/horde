<rml>
<head>
	<title>Round</title>
	<link type="text/rcss" href="tablet.rcss"/>
</head>
<body data-model="round">
	<div class="crosshair"><span class="v"/><span class="h"/></div>

	<div class="osd top-left">
		<span class="line">{{date}}</span>
		<span class="line">{{time}}</span>
		<span class="line money">{{money}}</span>
	</div>

	<div class="osd top-right">
		<span class="line">{{camera}}</span>
		<span class="line"><span class="rec-dot" data-class-off="!rec"/>REC</span>
		<span class="line">{{elapsed}}</span>
	</div>

	<div class="osd bottom-left">
		<span class="line">{{horde}}</span>
		<span class="line">BASE</span>
		<span class="pips"><span class="pip" data-for="p : base_pips" data-class-on="p == 1"></span></span>
	</div>

	<div class="osd bottom-right">
		<span class="line">{{channel}}</span>
	</div>

	<div class="hint">
		<span class="pill" data-if="problem != '' || hint_text != ''">
			<span class="problem" data-if="problem != ''">{{problem}}</span>
			<span class="name" data-if="problem == ''">{{hint_name}}</span>
			<span class="text" data-if="problem == ''">{{hint_text}}</span>
		</span>
	</div>
	<button class="act start" data-if="prep" data-event-click="start">Start</button>

	<div class="tray">
		<div class="slots">
			<div class="tower" data-for="t, i : items" data-class-selected="i == selected" data-class-disabled="t.disabled" data-class-group="t.group" data-event-click="pick(i)" data-event-mouseover="hover(i)" data-event-mouseout="hover(-1)">
				<div class="icon-tile"><span class="glyph-icon" data-style-color="t.color">{{t.icon}}</span></div>
				<span class="label">${{t.cost}}</span>
			</div>
		</div>
	</div>
	<div class="panel" data-if="panel_open" data-style-left="panel_x + 'px'" data-style-top="panel_y + 'px'">
		<span class="title">{{panel_name}}</span>
		<span class="kind">{{panel_kind}}</span>
		<span class="stat">{{panel_detail}}</span>
	</div>

	<div class="results" data-if="ended">
		<div class="card">
			<span class="verdict" data-class-won="won">{{result_title}}</span>
			<span class="stat">{{result_time}}</span>
			<span class="stat">{{result_kills}}</span>
			<span class="stat">{{result_leaked}}</span>
			<span class="earned" data-if="won">{{result_earned}}</span>
			<span class="stat" data-if="won">{{result_total}}</span>
			<div class="buttons">
				<button class="act" data-event-click="retry">Retry</button>
				<button class="act quiet" data-event-click="quit">Quit</button>
			</div>
		</div>
	</div>
</body>
</rml>
