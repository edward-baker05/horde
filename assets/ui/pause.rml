<rml>
<head>
	<title>Paused</title>
	<link type="text/rcss" href="phone.rcss"/>
</head>
<body data-model="pause">
	<div class="status-bar"></div>

	<div class="header">
		<span class="title">Paused</span>
	</div>

	<div class="list">
		<button class="row" data-event-click="resume">Resume</button>
		<button class="row" data-event-click="restart">Restart</button>
		<button class="row" data-if="!to_editor" data-event-click="quit">Quit to menu</button>
		<button class="row" data-if="to_editor" data-event-click="quit">Back to editor</button>
	</div>
</body>
</rml>
