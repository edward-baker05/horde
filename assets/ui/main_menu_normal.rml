<rml>
<head>
	<title>Main menu</title>
	<link type="text/rcss" href="phone_normal.rcss"/>
</head>
<body data-model="menu">
	<div class="status-bar">
		<span class="clock">{{clock}}</span>
		<span class="icons">
			<span class="signal"><span class="bar b1"/><span class="bar b2"/><span class="bar b3"/><span class="bar b4"/></span>
			<span class="wifi"></span>
			<span class="battery"><span class="charge"/></span><span class="nub"/>
		</span>
	</div>

	<!-- Home screen: the title and Play, app icons, and a dock of system apps.
	     Play's level picker opens over it, so it stays put underneath. -->
	<div class="page home" data-if="page == 'root' || page == 'play'">
		<div class="masthead">
			<span class="wordmark">HORDE<button class="dot" data-event-click="toggle_polish">.</button></span>
			<span class="subtitle">{{level_count}}</span>
		</div>
		<button class="play" data-event-click="open('play')"><span class="icon"></span>Play</button>

		<div class="apps">
			<button class="app" data-event-click="upgrades">
				<span class="app-icon"><span class="icon"></span></span>
				<span class="app-label">Upgrades</span>
			</button>
			<button class="app" data-event-click="editor">
				<span class="app-icon"><span class="icon"></span></span>
				<span class="app-label">Level Editor</span>
			</button>
		</div>
	</div>

	<div class="dock" data-if="page == 'root' || page == 'play'">
		<button class="app" data-event-click="open('dev')">
			<span class="app-icon"><span class="icon"></span></span>
			<span class="app-label">Dev Ground</span>
		</button>
		<button class="app" data-event-click="open('settings')">
			<span class="app-icon"><span class="icon"></span></span>
			<span class="app-label">Settings</span>
		</button>
		<button class="app" data-event-click="quit">
			<span class="app-icon"><span class="icon destructive"></span></span>
			<span class="app-label">Quit</span>
		</button>
	</div>

	<!-- Play's level picker: a card over a dimmed home screen. The scrim is a
	     sibling of the card, so taps on the card don't bubble to it. -->
	<div data-if="page == 'play'">
		<div class="scrim" data-event-click="back"/>
		<div class="popup-frame">
			<div class="popup">
				<span class="popup-title">Choose a Level</span>
				<div class="popup-list">
					<button class="option" data-for="name, i : levels" data-event-click="play(i)">{{name}}<span class="chevron"></span></button>
				</div>
				<button class="popup-cancel" data-event-click="back">Cancel</button>
			</div>
		</div>
	</div>

	<div data-if="page == 'dev'">
		<div class="header">
			<button class="back" data-event-click="back">‹ Menu</button>
		</div>
		<div class="page-title">Dev Ground</div>
		<div class="page scroll">
			<div class="section">LEVELS</div>
			<div class="group">
				<button class="row" data-event-click="dev_level(-1)">Built-in level<span class="hint">default</span><span class="chevron"></span></button>
				<button class="row" data-for="name, i : levels" data-event-click="dev_level(i)">{{name}}<span class="chevron"></span></button>
			</div>
			<div data-if="presets.size > 0">
				<div class="section">PRESETS</div>
				<div class="group">
					<button class="row" data-for="name, i : presets" data-event-click="dev_preset(i)">{{name}}<span class="chevron"></span></button>
				</div>
			</div>
		</div>
	</div>

	<div data-if="page == 'settings'">
		<div class="header">
			<button class="back" data-event-click="back">‹ Menu</button>
		</div>
		<div class="page-title">Settings</div>
		<div class="page scroll">
		</div>
	</div>

	<div class="home-bar"/>
</body>
</rml>
