/* Tablet round app, after iPadOS: the camera feed edge to edge, its readouts
   in small glass cards, and a floating glass dock of turrets over a fade at
   the bottom, with a capsule above it about the turret under the pointer.
   System colours, Inter, capsule buttons, and corners concentric with the
   card or screen around them. Sizes are in dp on the 1280x800 landscape
   tablet. The feed shows through the body, which ignores the pointer so
   clicks reach the scene; only the tray takes them. Same renderer limits as
   phone_normal.rcss: flat colours, vertex gradients, radii, opacity and
   transforms. Glass is a translucent fill with a light 1dp rim. */

body {
	font-family: "Inter";
	font-size: 17dp;
	color: #ffffff;
	width: 100%;
	height: 100%;
	display: block;
	pointer-events: none;
}

/* --- Feed readouts ------------------------------------------------------ */

/* Dark glass, so white text reads over any level colour. */
.osd {
	position: absolute;
	display: block;
	padding: 9dp 14dp 7dp 14dp;
	font-size: 15dp;
	font-weight: 600;
	background-color: #0000008c;
	border: 1dp #ffffff1f;
	border-radius: 16dp;
}

.osd .line {
	display: block;
	margin-bottom: 2dp;
}

/* The feed ends at the tray's top: 116dp up from the bottom. */
.top-left { left: 22dp; top: 22dp; }
.top-right { right: 22dp; top: 22dp; text-align: right; }
.bottom-left { left: 22dp; bottom: 130dp; }
.bottom-right { right: 22dp; bottom: 130dp; }

.osd .money {
	color: #30d158;
}

.rec-dot {
	display: inline-block;
	width: 10dp;
	height: 10dp;
	margin-right: 7dp;
	border-radius: 5dp;
	background-color: #ff453a;
	transition: opacity 0.15s;
}

.rec-dot.off {
	opacity: 0.25;
}

.pips {
	display: block;
	height: 14dp;
	margin: 4dp 0 2dp 0;
}

.pip {
	display: inline-block;
	width: 9dp;
	height: 14dp;
	margin-right: 3dp;
	border-radius: 3dp;
	background-color: #ffffff33;
}

.pip.on {
	background-color: #ffffff;
}

/* Centre of the feed: half of the 684dp above the tray. */
.crosshair {
	position: absolute;
	left: 50%;
	top: 342dp;
	width: 30dp;
	height: 30dp;
	margin: -15dp 0 0 -15dp;
}

.crosshair .v,
.crosshair .h {
	position: absolute;
	background-color: #ffffff59;
	border-radius: 1dp;
}

.crosshair .v { left: 14dp; top: 0; width: 2dp; height: 30dp; }
.crosshair .h { left: 0; top: 14dp; width: 30dp; height: 2dp; }

/* --- Turret tray --------------------------------------------------------- */

/* Height must match kRoundTrayFraction in src/scene/LevelMode.hpp. The band
   takes the pointer; the dock floats in it over a fade from the feed. */
.tray {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 116dp;
	display: flex;
	justify-content: center;
	align-items: center;
	decorator: vertical-gradient(#00000000 #000000b3);
	pointer-events: auto;
}

/* The dock: 8dp round 24dp-cornered items, so 32dp corners. */
.slots {
	display: flex;
	padding: 8dp;
	background-color: #1c1c1ee0;
	border: 1dp #ffffff2e;
	border-radius: 32dp;
}

.tower {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 66dp;
	height: 80dp;
	margin: 0 1dp;
	border: 1dp #00000000;
	border-radius: 24dp;
	transition: background-color 0.12s;
}

.tower:hover {
	background-color: #ffffff14;
}

.tower:active {
	transform: scale(0.95);
}

/* The icon and label leave the pointer to the item itself, so the whole item
   is one hover target: a mouseout bubbling up from a child would otherwise
   clear the hint while the pointer is still on the item. */
.tower .icon-tile,
.tower .label {
	pointer-events: none;
}

.tower.selected {
	background-color: #ffffff24;
	border-color: #ffffff3d;
}

/* The first of a weapon category, set apart from the group before. */
.tower.group {
	margin-left: 12dp;
}

.tower.disabled {
	opacity: 0.35;
}

.tower.disabled:hover {
	background-color: #00000000;
}

/* Each item's tile: neutral dark glass holding a line glyph in the item's
   tint, so the dock reads as one set and colour stays a cue, not a fill. */
.tower .icon-tile {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 44dp;
	height: 44dp;
	box-sizing: border-box;
	decorator: vertical-gradient(#3a3a3f #222226);
	border: 1dp #ffffff1f;
	border-radius: 11dp;
}

.tower .glyph-icon {
	font-family: "lucide";
	font-size: 22dp;
	line-height: 22dp;
}

.tower .label {
	display: block;
	margin-top: 6dp;
	font-size: 12dp;
	font-weight: 500;
	color: #ffffffd9;
}

/* --- Hint and start ------------------------------------------------------ */

/* Over the tray: what the turret under the pointer does, or why the one
   selected can't go where the pointer is, in a glass capsule. */
.hint {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 122dp;
	display: block;
	text-align: center;
	font-size: 13dp;
}

.hint .pill {
	display: inline-block;
	padding: 7dp 16dp;
	background-color: #000000a6;
	border: 1dp #ffffff1f;
	border-radius: 16dp;
}

.hint .name {
	font-weight: 600;
	color: #ffffff;
	margin-right: 8dp;
}

.hint .text {
	color: #ebebf5bf;
}

.hint .problem {
	font-weight: 600;
	color: #ff6961;
}

/* Two classes, to outrank .act's size. */
.act.start {
	position: absolute;
	left: 50%;
	bottom: 164dp;
	width: 150dp;
	height: 44dp;
	margin-left: -75dp;
	padding: 0;
	line-height: 44dp;
	font-size: 17dp;
	border-radius: 22dp;
	pointer-events: auto;
}

/* --- Turret panel -------------------------------------------------------- */

/* Placed by LevelScene in screen pixels, above the tower it describes. */
.panel {
	position: absolute;
	display: block;
	width: 176dp;
	padding: 12dp 14dp;
	background-color: #1c1c1ef0;
	border: 1dp #ffffff26;
	border-radius: 18dp;
	pointer-events: auto;
}

.panel .title,
.panel .kind,
.panel .stat {
	display: block;
}

.panel .kind {
	font-size: 12dp;
	font-weight: 500;
	color: #8e8e93;
	margin-top: 1dp;
}

.panel .title {
	font-weight: 600;
	font-size: 16dp;
}

.panel .stat {
	font-size: 13dp;
	color: #ebebf5cc;
	margin-top: 6dp;
}

/* Buttons are capsules in the tint. */
.act {
	display: block;
	height: 32dp;
	padding: 0 14dp;
	line-height: 32dp;
	text-align: center;
	font-size: 14dp;
	font-weight: 600;
	color: #ffffff;
	background-color: #0a84ff;
	border-radius: 16dp;
	transition: background-color 0.12s;
}

.act:hover {
	background-color: #409cff;
}

.act.disabled {
	background-color: #ffffff1f;
	color: #ffffff66;
}

/* --- Results ------------------------------------------------------------ */

.results {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 116dp;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: #00000080;
	pointer-events: auto;
}

/* Capsule buttons 20dp in from the edge, under 28dp corners. */
.results .card {
	display: block;
	width: 300dp;
	padding: 26dp 20dp 20dp 20dp;
	text-align: center;
	background-color: #1c1c1ef5;
	border: 1dp #ffffff26;
	border-radius: 28dp;
}

.results .verdict {
	display: block;
	font-size: 34dp;
	font-weight: 700;
	color: #ff453a;
	margin-bottom: 12dp;
}

.results .verdict.won {
	color: #30d158;
}

.results .stat,
.results .earned {
	display: block;
	font-size: 15dp;
	color: #ebebf5cc;
	margin: 4dp 0;
}

.results .earned {
	font-size: 22dp;
	font-weight: 700;
	color: #30d158;
}

.results .buttons {
	display: flex;
	justify-content: space-between;
	margin-top: 20dp;
}

.results .buttons .act {
	width: 124dp;
	height: 44dp;
	line-height: 44dp;
	font-size: 16dp;
	border-radius: 22dp;
}

.results .buttons .act.quiet {
	background-color: #ffffff1f;
}

.results .buttons .act.quiet:hover {
	background-color: #ffffff2e;
}
