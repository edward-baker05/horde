/* Tablet level editor, on top of tablet.rcss: the same glass readouts over the
   level, the same floating dock (holding tools instead of turrets), and
   iPadOS glass cards for everything that edits: an inspector on the left, the
   level sheet on the right, the armed tool's card above the dock. Sizes are
   dp on the 1280x800 landscape tablet; the feed is the 684dp above the tray. */

/* --- Cards -------------------------------------------------------------- */

.card {
	position: absolute;
	display: block;
	padding: 14dp 16dp;
	background-color: #1c1c1ef0;
	border: 1dp #ffffff26;
	border-radius: 24dp;
	pointer-events: auto;
}

.title {
	display: block;
	font-size: 17dp;
	font-weight: 600;
	margin-bottom: 4dp;
}

.heading {
	display: block;
	margin: 14dp 0 6dp 0;
	font-size: 13dp;
	font-weight: 600;
	color: #8e8e93;
}

.note {
	display: block;
	margin: 6dp 0 2dp 0;
	font-size: 12dp;
	color: #8e8e93;
}

.note.warn {
	color: #ffd60a;
}

.empty {
	display: block;
	padding: 4dp 10dp;
	font-size: 13dp;
	color: #636366;
}

/* Below the top bar and clear of the bottom-left readout. */
.inspector {
	left: 22dp;
	top: 98dp;
	width: 260dp;
	max-height: 440dp;
	overflow-y: auto;
}

.inspector .act {
	margin-top: 14dp;
}

.act.danger {
	background-color: #ff453a;
}

.act.danger:hover {
	background-color: #ff6961;
}

.act.quiet {
	margin-top: 8dp;
	background-color: #ffffff1f;
}

.act.quiet:hover {
	background-color: #ffffff2e;
}

/* --- Number fields ------------------------------------------------------ */

/* Label, then a stepper: round − and + either side of the value. */
.field {
	display: flex;
	align-items: center;
	height: 32dp;
	margin: 2dp 0;
}

.field .name {
	flex: 1;
	font-size: 14dp;
	color: #ebebf5;
}

.field .unit {
	width: 26dp;
	margin-left: 6dp;
	font-size: 12dp;
	color: #8e8e93;
}

button.step {
	width: 26dp;
	height: 26dp;
	line-height: 26dp;
	text-align: center;
	font-size: 16dp;
	font-weight: 600;
	color: #ffffff;
	background-color: #7676803d;
	border-radius: 13dp;
	transition: background-color 0.12s;
}

button.step:hover {
	background-color: #7676805c;
}

button.step:active {
	background-color: #0a84ff;
}

input.num,
input.hex,
input.name-box {
	height: 26dp;
	padding: 4dp 8dp;
	box-sizing: border-box;
	font-size: 14dp;
	color: #ffffff;
	background-color: #0000004d;
	border: 1dp #ffffff1a;
	border-radius: 8dp;
	cursor: text;
}

input.num {
	width: 72dp;
	margin: 0 5dp;
	text-align: right;
}

input.num:focus,
input.hex:focus,
input.name-box:focus {
	border-color: #0a84ff;
}

input.text selection {
	background-color: #0a84ff99;
	color: #ffffff;
}

/* --- Colours ------------------------------------------------------------ */

.colour {
	display: flex;
	align-items: center;
	margin: 4dp 0;
}

.colour .preview {
	width: 26dp;
	height: 26dp;
	margin-right: 8dp;
	border: 1dp #ffffff40;
	border-radius: 13dp;
}

input.hex {
	width: 100dp;
}

.swatches,
.palette {
	display: flex;
	flex-wrap: wrap;
	margin: 6dp 0 2dp 0;
}

/* Round wells, as in the system colour picker. */
.swatch {
	width: 22dp;
	height: 22dp;
	margin: 0 5dp 5dp 0;
	border: 1dp #ffffff2e;
	border-radius: 11dp;
	transition: transform 0.1s;
}

.swatch:hover {
	transform: scale(1.12);
	border-color: #ffffffa0;
}

.swatch.big {
	width: 30dp;
	height: 30dp;
	margin: 0 5dp 5dp 0;
	line-height: 28dp;
	text-align: center;
	font-size: 11dp;
	font-weight: 700;
	color: #ffffff;
	border-radius: 15dp;
	font-effect: outline(1dp #00000099);
}

.swatch.on {
	border: 2dp #ffffff;
}

/* --- Toggles and segments ---------------------------------------------- */

.toggle {
	display: flex;
	align-items: center;
	height: 34dp;
}

.toggle .name {
	flex: 1;
	font-size: 14dp;
	color: #ebebf5;
}

/* An iOS switch, green when on. */
.switch {
	position: relative;
	width: 44dp;
	height: 26dp;
	border-radius: 13dp;
	background-color: #39393d;
	transition: background-color 0.2s;
}

.switch.on {
	background-color: #30d158;
}

.switch .knob {
	position: absolute;
	top: 2dp;
	left: 2dp;
	width: 22dp;
	height: 22dp;
	border-radius: 11dp;
	background-color: #ffffff;
	transition: left 0.2s cubic-out;
}

.switch.on .knob {
	left: 20dp;
}

/* Segmented control: a capsule track with the chosen option raised in it. */
.seg {
	display: flex;
	margin-bottom: 8dp;
	padding: 2dp;
	background-color: #7676803d;
	border-radius: 16dp;
}

.seg .opt {
	flex: 1;
	height: 28dp;
	line-height: 28dp;
	text-align: center;
	font-size: 13dp;
	font-weight: 500;
	color: #ebebf5;
	border-radius: 14dp;
	transition: background-color 0.12s;
}

.seg .opt:hover {
	background-color: #ffffff14;
}

.seg .opt.on {
	font-weight: 600;
	color: #ffffff;
	background-color: #636366;
}

/* --- The level sheet ---------------------------------------------------- */

.sheet {
	position: absolute;
	right: 22dp;
	top: 22dp;
	bottom: 130dp;
	width: 310dp;
	display: block;
	background-color: #1c1c1ef0;
	border: 1dp #ffffff26;
	border-radius: 26dp;
	pointer-events: auto;
}

/* Folded, only the tabs show. */
.sheet.folded {
	bottom: auto;
	height: 46dp;
}

/* The tabs: a segmented control 6dp in, concentric with the sheet. */
.tabs {
	display: flex;
	margin: 6dp;
	padding: 2dp;
	background-color: #7676803d;
	border-radius: 20dp;
}

.tab {
	flex: 1;
	height: 30dp;
	line-height: 30dp;
	text-align: center;
	font-size: 13dp;
	font-weight: 500;
	color: #ebebf5;
	border-radius: 15dp;
	transition: background-color 0.12s;
}

.tab:hover {
	background-color: #ffffff14;
}

.tab.on {
	font-weight: 600;
	color: #ffffff;
	background-color: #636366;
}

.sheet .body {
	position: absolute;
	top: 50dp;
	bottom: 8dp;
	left: 0;
	right: 0;
	display: block;
	padding: 0 16dp 8dp 16dp;
	overflow-y: auto;
}

.sheet .heading:first-child {
	margin-top: 8dp;
}

scrollbarvertical {
	width: 3dp;
	margin-right: 4dp;
}

scrollbarvertical sliderbar {
	min-height: 32dp;
	background-color: #ffffff4d;
	border-radius: 2dp;
}

/* List rows: tap to select. */
.row {
	display: block;
	padding: 7dp 10dp;
	font-size: 14dp;
	color: #ebebf5;
	border-radius: 10dp;
	transition: background-color 0.12s;
}

.row:hover {
	background-color: #ffffff14;
}

.row.on {
	background-color: #0a84ff;
	color: #ffffff;
}

.row.bad {
	color: #ff6961;
}

.save {
	display: flex;
	align-items: center;
}

input.name-box {
	flex: 1;
	height: 32dp;
	margin-right: 8dp;
	font-size: 14dp;
}

.save .act {
	width: 72dp;
}

/* --- Tool card ---------------------------------------------------------- */

/* A strip above the tray that centres the card without taking clicks. */
.dock {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 124dp;
	display: flex;
	justify-content: center;
	pointer-events: none;
}

.tool-card {
	position: relative;
	width: 330dp;
}

.tool-card .note {
	margin-top: 8dp;
}

/* --- Top bar ----------------------------------------------------------- */

/* Undo and redo in a glass capsule, then the level's name card. */
.topbar {
	position: absolute;
	left: 22dp;
	top: 22dp;
	display: flex;
	pointer-events: auto;
}

.topbar .osd {
	position: static;
}

.title-card .sub {
	font-size: 13dp;
	font-weight: 500;
	color: #ebebf5bf;
}

.history {
	display: flex;
	align-items: center;
	margin-right: 8dp;
	padding: 0 5dp;
	background-color: #0000008c;
	border: 1dp #ffffff1f;
	border-radius: 26dp;
}

button.round {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 40dp;
	height: 40dp;
	border-radius: 20dp;
	transition: background-color 0.12s;
}

button.round + button.round {
	margin-left: 2dp;
}

button.round:hover {
	background-color: #ffffff1f;
}

button.round .icon {
	font-family: "lucide";
	font-size: 19dp;
	line-height: 19dp;
	color: #ffffff;
}

button.round.disabled .icon {
	color: #ffffff40;
}

button.round.disabled:hover {
	background-color: #00000000;
}

/* --- Sheet footer -------------------------------------------------------- */

/* Test play, pinned to the bottom of the Level tab: 12dp in, so a capsule
   sits concentric in the sheet's corners. */
.sheet .body.footed {
	bottom: 68dp;
}

.sheet .footer {
	position: absolute;
	left: 12dp;
	right: 12dp;
	bottom: 12dp;
}

.act.wide {
	height: 44dp;
	line-height: 44dp;
	font-size: 16dp;
	border-radius: 22dp;
}

.act .icon {
	margin-right: 8dp;
	font-family: "lucide";
	font-size: 16dp;
}

/* --- Readouts and dock --------------------------------------------------- */

.osd .problems {
	color: #ff6961;
}

.osd .status {
	color: #ffd60a;
}

/* Nine tools across. */
.tray .tower {
	width: 76dp;
	margin: 0 1dp;
}

.tray .tower .label {
	font-size: 11dp;
}

.tray .tower .key {
	position: absolute;
	top: 4dp;
	left: 6dp;
	font-size: 10dp;
	font-weight: 600;
	color: #8e8e93;
}
