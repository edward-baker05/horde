---
Language: Cpp
BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true

# Braces on the same line as the statement
BreakBeforeBraces: Attach

ColumnLimit: 120

# Pointers and references bind to the type: int* p, not int *p
PointerAlignment: Left
ReferenceAlignment: Left

# Keep short constructs expanded — easier to set breakpoints on
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# Includes: SDL3 first, then other third-party, then standard library, then our own
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<SDL3(_[a-z]+)?/'
    Priority: 1
  - Regex: '^<(glm/|imgui)'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 3
  - Regex: '^<.*>'
    Priority: 4
  - Regex: '.*'
    Priority: 5

# Misc
FixNamespaceComments: true
SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: Yes
EmptyLineBeforeAccessModifier: LogicalBlock
SeparateDefinitionBlocks: Always
