#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RWStructuredBuffer_v2uint
{
    uint2 _m0[1];
};

struct type_ClearParams
{
    uint totalCells;
    packed_uint3 padding;
};

kernel void main0(constant type_ClearParams& ClearParams [[buffer(0)]], device type_RWStructuredBuffer_v2uint& CellRanges [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    do
    {
        if (gl_GlobalInvocationID.x >= ClearParams.totalCells)
        {
            break;
        }
        CellRanges._m0[gl_GlobalInvocationID.x] = uint2(4294967295u);
        break;
    } while(false);
}

