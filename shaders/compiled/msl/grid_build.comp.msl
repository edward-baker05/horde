#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct UnitData
{
    float2 pos;
    float2 vel;
};

struct type_StructuredBuffer_UnitData
{
    UnitData _m0[1];
};

struct type_RWStructuredBuffer_v2uint
{
    uint2 _m0[1];
};

struct type_GridBuildParams
{
    float2 worldOrigin;
    float2 invCellSize;
    uint2 gridDim;
    uint unitCount;
    uint allocatedUnits;
};

kernel void main0(constant type_GridBuildParams& GridBuildParams [[buffer(0)]], device type_StructuredBuffer_UnitData& InUnits [[buffer(1)]], device type_RWStructuredBuffer_v2uint& GridKeys [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    do
    {
        if (gl_GlobalInvocationID.x >= GridBuildParams.allocatedUnits)
        {
            break;
        }
        if (gl_GlobalInvocationID.x >= GridBuildParams.unitCount)
        {
            GridKeys._m0[gl_GlobalInvocationID.x] = uint2(4294967295u);
            break;
        }
        GridKeys._m0[gl_GlobalInvocationID.x] = uint2(uint(clamp(int((InUnits._m0[gl_GlobalInvocationID.x].pos.x - GridBuildParams.worldOrigin.x) * GridBuildParams.invCellSize.x), 0, int(GridBuildParams.gridDim.x) - 1)) + (uint(clamp(int((InUnits._m0[gl_GlobalInvocationID.x].pos.y - GridBuildParams.worldOrigin.y) * GridBuildParams.invCellSize.y), 0, int(GridBuildParams.gridDim.y) - 1)) * GridBuildParams.gridDim.x), gl_GlobalInvocationID.x);
        break;
    } while(false);
}

