#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ReorderUniforms
{
    uint UnitCount;
    uint3 Padding;
};

kernel void main0(
    device const float2* Positions [[buffer(0)]],
    device const float2* Velocities [[buffer(1)]],
    device const uint* UnitStates [[buffer(2)]],
    device const uint* CellKeys [[buffer(3)]],
    device const uint* UnitLocalIndices [[buffer(4)]],
    device const uint* CellStarts [[buffer(5)]],
    device float2* SortedPositions [[buffer(6)]],
    device float2* SortedVelocities [[buffer(7)]],
    device uint* SortedUnitStates [[buffer(8)]],
    constant type_ReorderUniforms& uniforms [[buffer(9)]],
    uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint u = gl_GlobalInvocationID.x;
    if (u >= uniforms.UnitCount) return;

    uint cell = CellKeys[u];
    uint localSlot = UnitLocalIndices[u];
    uint sortedIdx = CellStarts[cell] + localSlot;

    if (sortedIdx < uniforms.UnitCount) {
        SortedPositions[sortedIdx] = Positions[u];
        SortedVelocities[sortedIdx] = Velocities[u];
        SortedUnitStates[sortedIdx] = UnitStates[u];
    }
}
