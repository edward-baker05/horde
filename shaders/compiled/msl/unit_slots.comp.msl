#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_StructuredBuffer_uint
{
    uint _m0[1];
};

struct type_RWStructuredBuffer_uint
{
    uint _m0[1];
};

struct type_SlotsParams
{
    uint UnitCount;
    packed_uint3 Padding;
};

kernel void main0(constant type_SlotsParams& SlotsParams [[buffer(0)]], device type_StructuredBuffer_uint& Ids [[buffer(1)]], device type_RWStructuredBuffer_uint& Slots [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    do
    {
        if (gl_GlobalInvocationID.x >= SlotsParams.UnitCount)
        {
            break;
        }
        Slots._m0[Ids._m0[gl_GlobalInvocationID.x]] = gl_GlobalInvocationID.x;
        break;
    } while(false);
}

