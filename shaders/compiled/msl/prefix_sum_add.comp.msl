#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_AddUniforms
{
    uint NumCells;
    uint3 Padding;
};

kernel void main0(
    device const uint* CellCounts [[buffer(0)]],
    device const uint* BlockSums [[buffer(1)]],
    device uint* CellStarts [[buffer(2)]],
    device uint* CellEnds [[buffer(3)]],
    constant type_AddUniforms& uniforms [[buffer(4)]],
    uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint cellIdx = gl_GlobalInvocationID.x;
    if (cellIdx >= uniforms.NumCells) return;

    uint blockIdx = cellIdx / 512;
    uint blockOffset = BlockSums[blockIdx];
    uint start = CellStarts[cellIdx] + blockOffset;
    uint count = CellCounts[cellIdx];

    CellStarts[cellIdx] = start;
    CellEnds[cellIdx] = start + count;
}
