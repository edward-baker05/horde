#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RmlUniforms
{
    float4x4 Transform;
    float2 Translation;
    float2 padding;
};

struct main0_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float4 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_RmlUniforms& RmlUniforms [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    out.gl_Position = RmlUniforms.Transform * float4(in.in_var_TEXCOORD0 + RmlUniforms.Translation, 0.0, 1.0);
    return out;
}

