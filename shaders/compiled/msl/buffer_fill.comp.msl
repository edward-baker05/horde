#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_RWStructuredBuffer_uint
{
    uint _m0[1];
};

struct type_FillParams
{
    uint Count;
    uint Value;
    uint Stride;
    uint Padding;
};

kernel void main0(constant type_FillParams& FillParams [[buffer(0)]], device type_RWStructuredBuffer_uint& Data [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    if (gl_GlobalInvocationID.x < FillParams.Count)
    {
        Data._m0[gl_GlobalInvocationID.x * FillParams.Stride] = FillParams.Value;
    }
}

