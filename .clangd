CompileFlags:
  # If a compilation database exists in any build directory, clangd will use it;
  # otherwise the fallback flags below provide full include paths and definitions.
  CompilationDatabase: build

  Add:
    - "-std=c++20"
    - "-Isrc"
    - "-Ibuild/windows/_deps/sdl3-src/include"
    - "-Ibuild/windows/_deps/sdl3_image-src/include"
    - "-Ibuild/windows/_deps/glm-src"
    - "-Ibuild/windows/_deps/imgui-src"
    - "-Ibuild/windows/_deps/imgui-src/backends"
    - "-Ibuild/_deps/sdl3-src/include"
    - "-Ibuild/_deps/sdl3_image-src/include"
    - "-Ibuild/_deps/glm-src"
    - "-Ibuild/_deps/imgui-src"
    - "-Ibuild/_deps/imgui-src/backends"
    - "-DWIN32"
    - "-D_WINDOWS"

  Remove:
    - "-fmodules-ts"
    - "-fmodule-mapper=*"
    - "-fdeps-format=*"
    - "/W4"
    - "/permissive-"

# Background indexing enables instant Go-to-Definition and Find References across the entire project
Index:
  Background: Build
  StandardLibrary: Yes

# Live static analysis and code health checks (like CLion's code inspections)
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  ClangTidy:
    Add:
      - "bugprone-*"
      - "performance-*"
      - "modernize-*"
      - "readability-*"
    Remove:
      - "modernize-use-trailing-return-type"
      - "readability-magic-numbers"
      - "readability-named-parameter"

# Rich inline hints (parameter names, deduced auto types, etc.)
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes
  DefaultArguments: Yes
  TypeNameLimit: 24

# Show alternative type names / typedef expansions on hover
Hover:
  ShowAKA: Yes

# Complete symbols from all headers even before they are included
Completion:
  AllScopes: Yes
